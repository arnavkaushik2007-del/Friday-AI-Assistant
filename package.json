{
  "name": "friday",
  "version": "1.0.0",
  "private": true,
  "description": "FRIDAY - a free, local, bilingual (Hindi/English) voice assistant for your PC and phone.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "phone": "node scripts/phone.js",
    "selftest": "node scripts/selftest.js",
    "tts-test": "node scripts/tts-test.js",
    "shortcut": "node scripts/desktop-icon.js"
  },
  "engines": {
    "node": ">=20.11"
  }
}
